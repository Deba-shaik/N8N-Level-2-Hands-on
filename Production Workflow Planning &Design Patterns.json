    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const transactionId = item.json.body?.transactionId;\n\n  if (!transactionId) {\n    throw new Error(\"Transaction ID is missing\");\n  }\n\n  return {\n    json: {\n      ...item.json,\n      transactionId: transactionId\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        -16
      ],
      "id": "18dc5cef-32d1-447d-b95f-7a48be0fe32f",
      "name": "Idempotency Verification"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json.body ?? item.json;\n\n  if (\n    !data.customerEmail ||\n    !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.customerEmail)\n  ) {\n    throw new Error(\"Invalid or missing customer email\");\n  }\n\n  if (\n    typeof data.amount !== \"number\" ||\n    !Number.isFinite(data.amount) ||\n    data.amount <= 0\n  ) {\n    throw new Error(\"Amount must be greater than 0\");\n  }\n\n  return {\n    json: {\n      ...item.json,\n      payload: {\n        transactionId: data.transactionId,\n        customerEmail: data.customerEmail,\n        amount: data.amount,\n        status: data.status\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
